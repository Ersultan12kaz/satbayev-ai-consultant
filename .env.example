# Copy to .env (1_setup.bat does it automatically and generates SECRET_KEY)
SECRET_KEY=put-a-long-random-string-here
ADMIN_EMAIL=admin@satbayev.university
ADMIN_PASSWORD=Admin12345!

# Local run (PyCharm): SQLite + in-memory numpy vectors
# DATABASE_URL=sqlite:///data/app.db   (default: data/app.db)
VECTOR_BACKEND=numpy

# Docker run: PostgreSQL + pgvector (set in docker-compose.yml)
# DATABASE_URL=postgresql+psycopg2://su:su_password@postgres:5432/su_rag
# VECTOR_BACKEND=pgvector

DEFAULT_MODE=hybrid
DEFAULT_TOP_K=5
# composer (default: question type + trained sentence ranker) | extractive (baseline)
GENERATOR=composer
RATE_LIMIT_PER_MINUTE=30
ALLOW_ANONYMOUS_CHAT=true
CORS_ORIGINS=*
